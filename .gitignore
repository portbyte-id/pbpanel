# Go build output
/panel
/panel-*
/bin/
/dist/
*.test
*.out
coverage.*

# Web
web/node_modules/
web/dist/*
# The placeholder keeps `go build ./...` working on a fresh checkout: the embed
# directive needs at least one file, and CI compiles Go before it builds the SPA.
!web/dist/index.html
web/.vite/
web/*.tsbuildinfo
web/playwright-report/
web/test-results/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
/.env
/.env.*
*.log
